# ── Base de datos (docker-compose la crea; define una contraseña larga y aleatoria) ──
POSTGRES_USER=fatboy
POSTGRES_PASSWORD=
POSTGRES_DB=fatboy

# Solo para desarrollo local sin docker-compose:
# DATABASE_URL=postgresql://fatboy:contraseña@localhost:5432/fatboy?schema=public

# ── Administrador inicial (se crea al primer arranque si no existe; no se vuelve a modificar) ──
# Contraseña: mínimo 12 caracteres con mayúsculas, minúsculas y números. Cámbiela tras el primer acceso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ── Aplicación ──
COOKIE_SECURE=true          # true cuando se sirve por HTTPS (Coolify). false solo para pruebas locales por HTTP.
SESSION_TTL_HOURS=12
APP_TIMEZONE=America/Tijuana
DATA_DIR=./data             # en Docker es /data (volumen persistente)
# CHROMIUM_PATH=/usr/bin/chromium   # ruta de Chromium para PDF/PNG (la imagen Docker ya lo trae)
